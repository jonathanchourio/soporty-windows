{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soporty",
  "version": "1.0.0",
  "identifier": "com.soporty.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Soporty",
        "width": 460,
        "height": 740,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "SpanishInternational", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
